# PostgreSQL and Redis development services
DATABASE_URL=postgresql+asyncpg://campuspilot:campuspilot@localhost:5432/campuspilot
REDIS_URL=redis://localhost:6379/0

# Replace these placeholders locally. Never commit real secrets.
JWT_SECRET=replace-with-a-local-random-secret
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
INTERNAL_TOOL_SECRET=replace-with-a-dedicated-internal-service-secret

# Application defaults
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
REFRESH_COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
USE_MOCK_CAMPUS_ADAPTERS=true
COMMUNITY_DATA_ENCRYPTION_KEY=
COMMUNITY_MATCH_ALGORITHM_VERSION=rule-v1
COMMUNITY_CONTACT_AUDIT_ENABLED=true

# M5 Agent runtime (paths are read only; startup does not create them)
LOCAL_ROUTER_MODEL_PATH=/models/router
LOCAL_ROUTER_CONFIDENCE=0.80
LOCAL_ROUTER_TIMEOUT_MS=500
RERANKER_MODEL_PATH=/models/reranker
RERANKER_ENABLED=false
RERANKER_TIMEOUT_MS=1000
AGENT_MAX_STEPS=6
AGENT_MAX_SPECIALISTS=3
AGENT_PARALLELISM=3
AGENT_RUN_TIMEOUT_SECONDS=120
AGENT_CHECKPOINT_SECRET=replace-with-a-dedicated-random-checkpoint-secret
AGENT_CHECKPOINT_TTL_SECONDS=3600
AGENT_RUNTIME_MAX_ATTEMPTS=3
AGENT_RUNTIME_BATCH_SIZE=1
AGENT_RUNTIME_CLAIM_TIMEOUT_SECONDS=60
AGENT_RUNTIME_POLL_SECONDS=2
AGENT_RUN_RATE_LIMIT_PER_MINUTE=20
INTERNAL_TOOL_RATE_LIMIT_PER_MINUTE=60
KNOWLEDGE_UPLOAD_ROOT=/data/knowledge
KNOWLEDGE_MAX_FILE_BYTES=20971520
KNOWLEDGE_MAX_FILES_PER_REQUEST=10
KNOWLEDGE_CHUNK_SIZE=500
KNOWLEDGE_CHUNK_OVERLAP=80
KNOWLEDGE_RETRIEVAL_TOP_K=5
KNOWLEDGE_SCORE_THRESHOLD=0.62
KNOWLEDGE_HISTORY_ROUNDS=6
KNOWLEDGE_CHROMA_PATH=/data/chroma
KNOWLEDGE_EMBEDDING_MODEL_PATH=/models/bge-small-zh-v1.5

# OpenSearch 混合检索配置
KNOWLEDGE_SEARCH_BACKEND=opensearch
KNOWLEDGE_OPENSEARCH_URL=http://localhost:9200
KNOWLEDGE_OPENSEARCH_USERNAME=admin
KNOWLEDGE_OPENSEARCH_PASSWORD=replace-with-your-opensearch-password
KNOWLEDGE_OPENSEARCH_INDEX_PREFIX=kb_
KNOWLEDGE_HYBRID_VECTOR_WEIGHT=0.7
KNOWLEDGE_HYBRID_BM25_WEIGHT=0.3
KNOWLEDGE_HYBRID_RRF_K=60

APPROVAL_TTL_SECONDS=600
TOOL_DEFAULT_TIMEOUT_MS=10000
MCP_ENABLED=false
MODEL_ARTIFACT_ROOT=/data/models
DATASET_ARTIFACT_ROOT=/data/datasets
DATASET_UPLOAD_TTL_SECONDS=3600
TRAINING_GPU_ENABLED=false
# ModelOps 执行模式：disabled（默认，评估任务稳定失败）| local（本机真实执行，逐批接入）
MODELOPS_EXECUTION_MODE=disabled
LOCAL_TRAINING_BASE_MODELS=Qwen/Qwen2.5-1.5B-Instruct
